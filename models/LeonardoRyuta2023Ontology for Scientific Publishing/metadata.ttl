<http://purl.org/ontouml-models/dataset/LeonardoRyuta2023Ontology for Scientific Publishing/> a dcat:Dataset, mod:SemanticArtefact;
    dct:title "Ontology for Scientific Publishing"@en;
    dct:issued "2023"^^xsd:gYear;
    dcat:theme <Class Q - Science>;
    dct:language "pt-br";
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    skos:editorialNote "The original name of the ontology, in portuguese, is \"Ontologia para Integração de Dados de Publicações Científicas";
    dcat:keyword "publishing", "sciences", "scientific publishing";
    mod:designedForTask <https://purl.org/ontouml-models/vocabulary/conceptual clarification>, <https://purl.org/ontouml-models/vocabulary/software engineering>;
    ontouml:context ontouml:research;
    ontouml:ontologyType ontouml:domain;
    ontouml:representationStyle ontouml:ontouml;
    dcat:distribution <http://purl.org/ontouml-models/dataset/LeonardoRyuta2023Ontology for Scientific Publishing/distribution/ttl>.
<http://purl.org/ontouml-models/dataset/LeonardoRyuta2023Ontology for Scientific Publishing/distribution/ttl> a dcat:Distribution;
    dct:title "Turtle distribution of \"Ontology for Scientific Publishing\""@en;
    dcat:mediaType "text/turtle";
    dcat:downloadURL <https://raw.githubusercontent.com/LeonardoRyuta/ontouml-models/master/LeonardoRyuta2023Ontology for Scientific Publishing/ontology.ttl>.
<http://purl.org/ontouml-models/dataset/LeonardoRyuta2023Ontology for Scientific Publishing/> dcat:distribution <http://purl.org/ontouml-models/dataset/LeonardoRyuta2023Ontology for Scientific Publishing/distribution/json>.
